# Kafka Cluster
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=telemetry_financial_events
KAFKA_TOPIC_DLQ=telemetry_events_dlq
KAFKA_CONSUMER_GROUP=pyspark_streaming_analytics_group

# PySpark Streaming Engine
SPARK_APP_NAME=RealTimeFinancialStreamAnalytics
SPARK_MASTER=local[*]
SPARK_STREAM_TRIGGER_INTERVAL=5 seconds
SPARK_WATERMARK_DELAY=10 minutes
SPARK_WINDOW_DURATION=5 minutes
SPARK_SLIDE_DURATION=1 minute

# PostgreSQL OLTP
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streaming_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass

# Redis Hot-Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
